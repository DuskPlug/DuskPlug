#include "resource.h"
#include <windows.h>
#include <commctrl.h>

1 ICON "../../assets/app.ico"
1 RT_MANIFEST "app.manifest"

IDD_SCHEDULE DIALOG DISCARDABLE 0, 0, 280, 150
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Daily Schedule"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "Turn plug ON at:", -1, 14, 18, 110, 10
    CONTROL "", IDC_ON_TIME, "SysDateTimePick32", DTS_TIMEFORMAT | DTS_UPDOWN | WS_TABSTOP | WS_CHILD | WS_VISIBLE, 130, 14, 130, 22
    LTEXT "Turn plug OFF at:", -1, 14, 52, 110, 10
    CONTROL "", IDC_OFF_TIME, "SysDateTimePick32", DTS_TIMEFORMAT | DTS_UPDOWN | WS_TABSTOP | WS_CHILD | WS_VISIBLE, 130, 48, 130, 22
    LTEXT "Uses your PC clock every day. Overnight spans (e.g. 22:00 to 06:00) are OK.", -1, 14, 78, 250, 20
    DEFPUSHBUTTON "OK", IDOK, 120, 112, 72, 24
    PUSHBUTTON "Cancel", IDCANCEL, 200, 112, 72, 24
END

IDD_SETTINGS DIALOG DISCARDABLE 0, 0, 430, 390
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "DuskPlug Settings"
FONT 9, "Segoe UI"
BEGIN
    GROUPBOX "Plug connection", -1, 8, 8, 414, 108
    LTEXT "Access ID:", -1, 16, 24, 72, 8
    EDITTEXT IDC_SET_CLIENT_ID, 92, 22, 320, 14, ES_AUTOHSCROLL
    LTEXT "Access Secret:", -1, 16, 42, 72, 8
    EDITTEXT IDC_SET_CLIENT_SECRET, 92, 40, 320, 14, ES_AUTOHSCROLL | ES_PASSWORD
    LTEXT "Device ID:", -1, 16, 60, 72, 8
    EDITTEXT IDC_SET_DEVICE_ID, 92, 58, 320, 14, ES_AUTOHSCROLL
    LTEXT "Data center:", -1, 16, 78, 72, 8
    COMBOBOX IDC_SET_DATA_CENTER, 92, 76, 320, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

    GROUPBOX "Smart Mode location", -1, 8, 122, 414, 78
    LTEXT "Latitude:", -1, 16, 138, 48, 8
    EDITTEXT IDC_SET_LATITUDE, 68, 136, 72, 14, ES_AUTOHSCROLL
    LTEXT "Longitude:", -1, 148, 138, 48, 8
    EDITTEXT IDC_SET_LONGITUDE, 200, 136, 72, 14, ES_AUTOHSCROLL
    PUSHBUTTON "Detect Location", IDC_SET_DETECT_LOCATION, 284, 134, 96, 18
    LTEXT "After sunset (min):", -1, 16, 162, 88, 8
    EDITTEXT IDC_SET_DARK_OFFSET, 108, 160, 48, 14, ES_AUTOHSCROLL | ES_NUMBER
    LTEXT "Before sunrise (min):", -1, 168, 162, 96, 8
    EDITTEXT IDC_SET_LIGHT_OFFSET, 268, 160, 48, 14, ES_AUTOHSCROLL | ES_NUMBER

    GROUPBOX "Daily schedule", -1, 8, 206, 414, 58
    LTEXT "Turn plug ON at:", -1, 16, 224, 88, 8
    CONTROL "", IDC_SET_ON_TIME, "SysDateTimePick32", DTS_TIMEFORMAT | DTS_UPDOWN | WS_TABSTOP | WS_CHILD | WS_VISIBLE, 108, 220, 120, 22
    LTEXT "Turn plug OFF at:", -1, 240, 224, 88, 8
    CONTROL "", IDC_SET_OFF_TIME, "SysDateTimePick32", DTS_TIMEFORMAT | DTS_UPDOWN | WS_TABSTOP | WS_CHILD | WS_VISIBLE, 332, 220, 80, 22

    GROUPBOX "Advanced", -1, 8, 270, 414, 52
    LTEXT "Switch code:", -1, 16, 286, 56, 8
    EDITTEXT IDC_SET_SWITCH_CODE, 76, 284, 96, 14, ES_AUTOHSCROLL
    LTEXT "Lock-off seconds:", -1, 184, 286, 80, 8
    EDITTEXT IDC_SET_LOCK_OFF, 268, 284, 48, 14, ES_AUTOHSCROLL | ES_NUMBER

    DEFPUSHBUTTON "Save", IDOK, 270, 358, 72, 22
    PUSHBUTTON "Cancel", IDCANCEL, 348, 358, 72, 22
END
