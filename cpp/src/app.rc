#include "resource.h"
#include "version.h"
#include <windows.h>
#include <commctrl.h>

VS_VERSION_INFO VERSIONINFO
FILEVERSION DUSKPLUG_VERSION_MAJOR,DUSKPLUG_VERSION_MINOR,DUSKPLUG_VERSION_PATCH,0
PRODUCTVERSION DUSKPLUG_VERSION_MAJOR,DUSKPLUG_VERSION_MINOR,DUSKPLUG_VERSION_PATCH,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "DuskPlug"
            VALUE "FileDescription", "DuskPlug"
            VALUE "FileVersion", DUSKPLUG_VERSION
            VALUE "InternalName", "DuskPlug"
            VALUE "OriginalFilename", "DuskPlug.exe"
            VALUE "ProductName", "DuskPlug"
            VALUE "ProductVersion", DUSKPLUG_VERSION
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

1 ICON "../../assets/app.ico"
1 RT_MANIFEST "app.manifest"

IDD_SCHEDULE DIALOG DISCARDABLE 0, 0, 280, 150
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Daily Schedule"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "Turn plug ON at:", -1, 14, 18, 110, 10
    CONTROL "", IDC_ON_TIME, "SysDateTimePick32", DTS_TIMEFORMAT | DTS_UPDOWN | WS_TABSTOP | WS_CHILD | WS_VISIBLE, 130, 14, 130, 22
    LTEXT "Turn plug OFF at:", -1, 14, 52, 110, 10
    CONTROL "", IDC_OFF_TIME, "SysDateTimePick32", DTS_TIMEFORMAT | DTS_UPDOWN | WS_TABSTOP | WS_CHILD | WS_VISIBLE, 130, 48, 130, 22
    LTEXT "Uses your PC clock every day. Overnight spans (e.g. 22:00 to 06:00) are OK.", -1, 14, 78, 250, 20
    DEFPUSHBUTTON "OK", IDOK, 120, 112, 72, 24
    PUSHBUTTON "Cancel", IDCANCEL, 200, 112, 72, 24
END

IDD_TIMED DIALOG DISCARDABLE 0, 0, 280, 110
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Timed Mode"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "Turn devices on now, then off after:", -1, 14, 18, 250, 10
    LTEXT "Minutes:", -1, 14, 44, 60, 10
    EDITTEXT IDC_TIMED_MINUTES, 80, 40, 80, 14, ES_AUTOHSCROLL | ES_NUMBER
    LTEXT "Enter 1 to 10080 minutes (7 days).", -1, 14, 64, 250, 10
    DEFPUSHBUTTON "OK", IDOK, 120, 76, 72, 24
    PUSHBUTTON "Cancel", IDCANCEL, 200, 76, 72, 24
END
